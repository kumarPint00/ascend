{
  "expo": {
    "name": "ASCEND",
    "slug": "ascend-real-life-rpg",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "ascendrpg",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090F1D",
    "android": {
      "package": "com.ascendrpg.personal",
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#090F1D"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.ascendrpg.personal",
      "supportsTablet": false
    },
    "plugins": [
      "expo-sqlite"
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
